  "method": "Four separate 8-second M1 Instruments Metal System Traces, with Performance Limiters (profile 3) and Performance Utilizations (profile 4), each in compute-then-ALU and ALU-then-compute order. Each trace launched two checksum-verified packaged Metal probe processes sequentially with a 0.25-second gap, 100 passes and 65,536 items per mode. The device-wide counter export was summarized separately by each recorded probe PID; the traces were not intentionally concurrent. Raw traces stay local.",
  "probe_source_sha256": "da9260233b4e1ebd16764d070e56c5c7bffb427192d055f8cbc9ff028a93adf0",
  "probe_binary_sha256": "93ae438444bacdf18867bc01996ae5bd6f0c1cc1e26db507048ecb0586ee338f",
  "launcher_source": "import subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nbinary = Path(sys.argv[1])\noutput = Path(sys.argv[2])\norder = sys.argv[3:]\ntime.sleep(0.4)\nfor mode in order:\n    child = subprocess.Popen([str(binary), '100', '--mode', mode, '--items', '65536',\n                              '--result', str(output / f'{mode}.json')],\n                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n    stdout, stderr = child.communicate(timeout=30)\n    print(f'probe_pid={child.pid} mode={mode}', flush=True)\n    print(stdout, end='', flush=True)\n    if child.returncode or 'checksum_verified=true' not in stdout:\n        print(stderr, flush=True)\n        raise SystemExit(f'{mode} probe failed')\n    time.sleep(0.25)\ntime.sleep(1)\n",
