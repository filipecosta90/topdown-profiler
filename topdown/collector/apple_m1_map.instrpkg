<?xml version="1.0" encoding="UTF-8"?>
<package>
  <id>org.redis-performance.topdown.m1-map-state</id>
  <title>Topdown M1 Map State</title>
  <owner><name>topdown-profiler</name></owner>
  <import-schema>counters-profile</import-schema>
  <instrument>
    <id>org.redis-performance.topdown.m1-map-state.instrument</id>
    <title>Topdown M1 Map State</title>
    <category>CPU</category>
    <purpose>Observe M1 map pipeline events for independent calibration.</purpose>
    <icon>CPU Counters</icon>
    <limitations/>
    <create-table>
      <id>m1-map-state-profile</id>
      <schema-ref>counters-profile</schema-ref>
      <attribute><name>target-pid</name><string>SINGLE</string></attribute>
      <attribute><name>needs-kernel-callstack</name><integer>0</integer></attribute>
      <attribute><name>pmc-events</name><array>
        <string>FIXED_CYCLES</string><string>FIXED_INSTRUCTIONS</string>
        <string>RETIRE_UOP</string><string>MAP_DISPATCH_BUBBLE</string>
        <string>MAP_STALL</string><string>MAP_REWIND</string>
        <string>MAP_STALL_DISPATCH</string><string>MAP_INT_UOP</string>
        <string>MAP_LDST_UOP</string><string>MAP_SIMD_UOP</string>
      </array></attribute>
      <attribute><name>trigger</name><string>time</string></attribute>
      <attribute><name>sample-rate-micro-seconds</name><integer>1000</integer></attribute>
    </create-table>
    <list>
      <title>Native M1 Map State Samples</title>
      <table-ref>m1-map-state-profile</table-ref>
      <column>time</column><column>process</column><column>thread</column><column>counters-array</column>
    </list>
  </instrument>
</package>
